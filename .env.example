# Beyond Beauty Saloon - Environment Configuration Example
# Copy this file to .env and adjust variables as needed for local development.

# Application Environment
NODE_ENV=development
APP_NAME="Beyond Beauty Saloon"
APP_TIMEZONE="Asia/Kolkata"

# Database Configuration
# For local zero-dependency development (SQLite):
# DATABASE_URL="file:./dev.db"
# For Docker or local PostgreSQL instance:
DATABASE_URL="postgresql://postgres:postgres_password_dev@localhost:5432/beyond_beauty_saloon?schema=public"

# Redis Cache & Background Jobs (BullMQ)
REDIS_URL="redis://localhost:6379"

# Security & Authentication
# In production, generate a cryptographically random string (e.g. `openssl rand -hex 32`)
JWT_SECRET="beyond_beauty_saloon_dev_secret_key_minimum_32_chars_long"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="beyond_beauty_cookie_dev_secret_32_chars"

# Service Ports
PORT=4000
API_PORT=4000
WEB_PORT=3000

# URLs for CORS and cross-service communication
API_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Initial Admin Bootstrap (Used only by database seed script)
INITIAL_ADMIN_EMAIL="admin@beyondbeauty.local"
INITIAL_ADMIN_PASSWORD="AdminPassword123!"

# External Provider Placeholders (Optional - in-app alerts are active by default)
# SMS_GATEWAY_PROVIDER=""
# SMS_GATEWAY_API_KEY=""
# WHATSAPP_API_TOKEN=""
